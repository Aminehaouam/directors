  "voiceover": {
    "path": "public/audio/voiceover.wav",
    "cues": [
      {
        "id": "c1",
        "start": 0.3,
        "end": 4.7,
        "text": "The unsettling thing about The Matrix isn't that reality is fake.",
        "words": {"unsettling": 0.12, "fake": 0.88}
      },
      {
        "id": "c2",
        "start": 5.1,
        "end": 9.1,
        "text": "It's that nobody has to force you to accept it.",
        "words": {"nobody": 0.2, "force": 0.45, "accept": 0.72}
      },
      {
        "id": "c3",
        "start": 9.6,
        "end": 13.6,
        "text": "The system offers routines. Rewards. Reasons never to ask.",
        "words": {"routines": 0.22, "rewards": 0.42, "reasons": 0.6, "never": 0.71, "to": 0.79, "ask": 0.88}
      },
      {
        "id": "c4",
        "start": 14.0,
        "end": 17.2,
        "text": "Slowly, the prison stops looking like a prison.",
        "words": {"prison1": 0.22, "prison2": 0.78}
      },
      {
        "id": "c5",
        "start": 17.4,
        "end": 19.8,
        "text": "It starts looking like your life.",
        "words": {"your": 0.55, "life": 0.75}
      },
      {
        "id": "c6",
        "start": 20.1,
        "end": 22.5,
        "text": "And obedience starts to feel natural.",
        "words": {"obedience": 0.24, "natural": 0.72}
      },
      {
        "id": "c7",
        "start": 23.2,
        "end": 26.0,
        "text": "Neo's awakening isn't about seeing the truth.",
        "words": {"awakening": 0.17, "truth": 0.8}
      },
      {
        "id": "c8",
        "start": 26.5,
        "end": 29.3,
        "text": "It's about what the truth will cost.",
        "words": {"the": 0.3, "truth": 0.44, "cost": 0.66}
      }
    ]
  },
